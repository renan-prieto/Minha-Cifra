DB_HOST=127.0.0.1
DB_USER=your_database_user
DB_PASSWORD=replace_with_a_strong_database_password
DB_NAME=minhacifra

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=replace_with_your_smtp_password
EMAIL_FROM="Minha Cifra <no-reply@example.com>"
PUBLIC_API_URL=https://api.example.com

GEMINI_API_KEY=
GEMINI_MODEL=

# Opcional: porta HTTP da API (padrão 3000)
PORT=3000

# Opcional: origens permitidas no navegador, separadas por vírgula.
# Em produção, informe apenas o domínio do app web, por exemplo:
# CORS_ORIGINS=https://app.minhacifra.com
CORS_ORIGINS=

# Opcional: habilite quando a API estiver atrás de um proxy reverso confiável.
# Use 1 para confiar em um proxy (Nginx, Railway, Render etc.).
TRUST_PROXY==